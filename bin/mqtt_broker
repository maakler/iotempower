#!/usr/bin/env bash
if [[ "$*" = "help" || "$*" = "-h" || "$*" = "--help" ]]; then
cat << EOF
Syntax: mqtt_broker [interface1|scanif [ip1 [interface2 [ip2]]]]

mqtt_broker starts a local mosquitto-mqtt-server corresponding to parameters
set in iotempower/etc/iotempower.conf. If interface1 is given it overwrites
the listener address with this interface. If ip1 is provided, this IP will be
used directly instead of scanning the interface address. If interface2 is also
provided, the broker will listen on both interfaces. If ip2 is provided, this
IP will be used directly for the second listener. If scanif is given for
interface1, it will try to guess the interface itself.
EOF
exit 1
fi

[ "$IOTEMPOWER_ACTIVE" = "yes" ] || { echo "IoTempower not active, aborting." 1>&2; exit 1; }
source <(iot_env ignore_system)

APTEMP="$IOTEMPOWER_LOCAL/tmp/mosquitto"
rm -rf "$APTEMP" &> /dev/null
mkdir -p "$APTEMP"

mqtt_auth_enabled=false

mqtt_fail() {
    echo "$1" 1>&2
    exit 1
}

mqtt_create_password_file() {
    local password_file="$1"
    local password_file_tmp="${password_file}.tmp"
    local old_umask=""
    local result=0

    rm -f "$password_file_tmp"
    old_umask="$(umask)"
    umask 077
    if printf '%s\n%s\n' "$IOTEMPOWER_MQTT_PW" "$IOTEMPOWER_MQTT_PW" \
            | mosquitto_passwd -c "$password_file_tmp" "$IOTEMPOWER_MQTT_USER" >/dev/null; then
        chmod 600 "$password_file_tmp" || result=1
        mv -f "$password_file_tmp" "$password_file" || result=1
        chmod 600 "$password_file" || result=1
    else
        result=1
    fi
    umask "$old_umask"
    if [[ "$result" != 0 ]]; then
        rm -f "$password_file_tmp"
        return 1
    fi
}

mqtt_write_acl_file() {
    local acl_file="$1"
    local system_dir=""
    local node_conf=""
    local node_topic=""

    {
        echo "user $IOTEMPOWER_MQTT_USER"
        echo "topic read #"
        echo "topic write iotempower/_cfg_/#"
        if [[ "$IOTEMPOWER_MQTT_DISCOVERY_PREFIX" ]]; then
            echo "topic write $IOTEMPOWER_MQTT_DISCOVERY_PREFIX/#"
        fi

        if [[ "$IOTEMPOWER_SYSTEM_CONFIG" && -e "$IOTEMPOWER_SYSTEM_CONFIG" ]]; then
            system_dir="$(dirname "$IOTEMPOWER_SYSTEM_CONFIG")"
            while IFS= read -r -d '' node_conf; do
                node_topic="$(mqtt_node_topic_from_path "$system_dir" "$node_conf")" || exit 1
                if [[ "$node_topic" ]]; then
                    echo "topic write $node_topic/#"
                fi
            done < <(find "$system_dir" -name node.conf -print0)
        fi
    } > "$acl_file"
}

mqtt_write_psk_file() {
    local psk_file="$1"
    local psk_hex="${IOTEMPOWER_MQTT_PSK_HEX,,}"
    local system_dir=""
    local node_conf=""
    local node_identity=""
    local node_psk_hex=""
    local psk_entries=0
    local old_umask=""
    declare -A psk_identities=()

    if [[ "$IOTEMPOWER_MQTT_PSK_IDENTITY" || "$psk_hex" ]]; then
        [[ "$IOTEMPOWER_MQTT_PSK_IDENTITY" && "$psk_hex" ]] \
            || mqtt_fail "MQTT TLS PSK mode requires both IOTEMPOWER_MQTT_PSK_IDENTITY and IOTEMPOWER_MQTT_PSK_HEX when either is set. Aborting."
        mqtt_validate_psk_entry "$IOTEMPOWER_MQTT_PSK_IDENTITY" "$psk_hex"
    fi

    old_umask="$(umask)"
    umask 077
    : > "$psk_file" || {
        umask "$old_umask"
        return 1
    }

    if [[ "$IOTEMPOWER_MQTT_PSK_IDENTITY" && "$psk_hex" ]]; then
        mqtt_append_psk_entry "$psk_file" "$IOTEMPOWER_MQTT_PSK_IDENTITY" "$psk_hex" \
            || { umask "$old_umask"; return 1; }
        psk_identities["$IOTEMPOWER_MQTT_PSK_IDENTITY"]=1
        ((psk_entries++))
    fi

    if [[ "$IOTEMPOWER_SYSTEM_CONFIG" && -e "$IOTEMPOWER_SYSTEM_CONFIG" ]]; then
        system_dir="$(dirname "$IOTEMPOWER_SYSTEM_CONFIG")"
        while IFS= read -r -d '' node_conf; do
            node_identity="$(mqtt_read_node_config_var "$node_conf" "IOTEMPOWER_MQTT_PSK_IDENTITY")" \
                || mqtt_fail "Failed to parse IOTEMPOWER_MQTT_PSK_IDENTITY in $node_conf. Aborting."
            node_psk_hex="$(mqtt_read_node_config_var "$node_conf" "IOTEMPOWER_MQTT_PSK_HEX")" \
                || mqtt_fail "Failed to parse IOTEMPOWER_MQTT_PSK_HEX in $node_conf. Aborting."
            node_psk_hex="${node_psk_hex,,}"
            [[ ! "$node_identity" && ! "$node_psk_hex" ]] && continue
            [[ "$node_identity" && "$node_psk_hex" ]] \
                || mqtt_fail "MQTT TLS PSK node config requires both IOTEMPOWER_MQTT_PSK_IDENTITY and IOTEMPOWER_MQTT_PSK_HEX in $node_conf. Aborting."
            mqtt_validate_psk_entry "$node_identity" "$node_psk_hex"
            [[ ! "${psk_identities[$node_identity]+set}" ]] \
                || mqtt_fail "Duplicate MQTT TLS PSK identity '$node_identity' in $node_conf. Aborting."
            mqtt_append_psk_entry "$psk_file" "$node_identity" "$node_psk_hex" \
                || { umask "$old_umask"; return 1; }
            psk_identities["$node_identity"]=1
            ((psk_entries++))
        done < <(find "$system_dir" -name node.conf -print0)
    fi

    (( psk_entries > 0 )) \
        || mqtt_fail "MQTT TLS PSK mode requires at least one system or node PSK identity/key pair. Aborting."
    chmod 600 "$psk_file" || {
        umask "$old_umask"
        return 1
    }
    umask "$old_umask"
}

mqtt_validate_psk_entry() {
    local psk_identity="$1"
    local psk_hex="$2"

    [[ "$psk_identity" != *[[:space:]:]* ]] \
        || mqtt_fail "MQTT TLS PSK identity may not contain whitespace or colon. Aborting."
    [[ "$psk_hex" =~ ^([0-9a-f]{2})+$ && ${#psk_hex} -ge 32 ]] \
        || mqtt_fail "IOTEMPOWER_MQTT_PSK_HEX must be even-length hexadecimal with at least 16 bytes. Aborting."
}

mqtt_append_psk_entry() {
    local psk_file="$1"
    local psk_identity="$2"
    local psk_hex="$3"

    printf '%s:%s\n' "$psk_identity" "$psk_hex" >> "$psk_file"
}

mqtt_node_topic_from_path() {
    local system_dir="$1"
    local node_conf="$2"
    local node_dir=""
    local rel_topic=""
    local configured_topic=""

    system_dir="$(cd "$system_dir" && pwd -P)" || return 1
    node_dir="$(cd "$(dirname "$node_conf")" && pwd -P)" || return 1

    if [[ "$node_dir" == "$system_dir" ]]; then
        rel_topic=""
    else
        case "$node_dir" in
            "$system_dir"/*)
                rel_topic="${node_dir#"$system_dir"/}"
                ;;
            *)
                return 1
                ;;
        esac
    fi

    configured_topic="$(mqtt_read_node_topic "$node_conf")" || return 1
    if [[ "$configured_topic" ]]; then
        printf '%s' "$configured_topic"
        return 0
    fi

    printf '%s' "$rel_topic"
}

mqtt_read_node_topic() {
    local node_conf="$1"
    local parsed_topic=""

    parsed_topic="$(mqtt_read_node_config_var "$node_conf" "topic")" || return 1
    printf '%s' "$parsed_topic"
}

mqtt_read_node_config_var() {
    local node_conf="$1"
    local key="$2"
    local line=""
    local value=""
    local parsed_value=""

    while IFS= read -r line || [[ "$line" ]]; do
        [[ "$line" =~ ^[[:space:]]*${key}[[:space:]]*= ]] || continue
        value="${line#*=}"
        value="${value#"${value%%[![:space:]]*}"}"
        value="${value%"${value##*[![:space:]]}"}"
        parsed_value="$(mqtt_parse_config_value "$value")" || return 1
    done < "$node_conf"

    printf '%s' "$parsed_value"
}

mqtt_parse_config_value() {
    local value="$1"
    local result=""
    local char=""
    local next_char=""
    local rest=""

    if [[ "$value" == \"* ]]; then
        value="${value:1}"
        while [[ "$value" ]]; do
            char="${value:0:1}"
            value="${value:1}"
            if [[ "$char" == "\\" && "$value" ]]; then
                next_char="${value:0:1}"
                value="${value:1}"
                result+="$next_char"
            elif [[ "$char" == '"' ]]; then
                rest="$value"
                rest="${rest#"${rest%%[![:space:]]*}"}"
                [[ ! "$rest" || "$rest" == \#* ]] || return 1
                printf '%s' "$result"
                return 0
            else
                result+="$char"
            fi
        done
        return 1
    elif [[ "$value" == \'* ]]; then
        value="${value:1}"
        [[ "$value" == *"'"* ]] || return 1
        result="${value%%\'*}"
        rest="${value#*\'}"
        rest="${rest#"${rest%%[![:space:]]*}"}"
        [[ ! "$rest" || "$rest" == \#* ]] || return 1
        printf '%s' "$result"
    else
        case "$value" in
            *[[:space:]]*|*[\`\$\\]*)
                return 1
                ;;
            *)
                value="${value%%#*}"
                value="${value%"${value##*[![:space:]]}"}"
                printf '%s' "$value"
                ;;
        esac
    fi
}

while true; do
    IF1="$1"
    IP1="$2"
    IF2="$3"
    IP2="$4"

    if [[ "$IP1" && "$IP1" != *.*.*.* ]]; then
        IF2="$IP1"
        IP1=""
        if [[ "$4" ]]; then
            IP2="$4"
        elif [[ "$3" && "$3" == *.*.*.* ]]; then
            IP2="$3"
        fi
    fi

    if [[ "$IF1" ]]; then
        if [[ "$IF1" = "scanif" ]]; then
            if_search=$(find_local_network)
            IF1=$(echo $if_search|cut -d\  -f1)
            echo "Preferred interface: $IF1"
        fi
        if [[ "$IP1" ]]; then
            export IOTEMPOWER_MQTT_HOST="$IP1"
        else
            export IOTEMPOWER_MQTT_HOST=$(show_local_ips | grep "$IF1" | cut -d\  -f2|cut -d/ -f1)
        fi
    fi

    if [[ "$IF2" ]]; then
        if [[ "$IP2" ]]; then
            export IOTEMPOWER_MQTT_HOST2="$IP2"
        else
            export IOTEMPOWER_MQTT_HOST2=$(show_local_ips | grep "$IF2" | cut -d\  -f2|cut -d/ -f1)
        fi
    fi

    echo "Listening on $IOTEMPOWER_MQTT_HOST."
    [[ "$IOTEMPOWER_MQTT_HOST2" ]] && echo "Also listening on $IOTEMPOWER_MQTT_HOST2."

    mqtt_tls_mode="${IOTEMPOWER_MQTT_TLS_MODE:-cert}"
    [[ "$mqtt_tls_mode" == "cert" || "$mqtt_tls_mode" == "psk" ]] \
        || mqtt_fail "Unsupported MQTT TLS mode: $mqtt_tls_mode"
    if [[ "$mqtt_tls_mode" == "psk" && "$IOTEMPOWER_MQTT_USE_TLS" != 1 ]]; then
        mqtt_fail "MQTT TLS PSK mode requires TLS. Aborting."
    fi

    mqtt_auth_enabled=false
    if [[ "$IOTEMPOWER_MQTT_USER" || "$IOTEMPOWER_MQTT_PW" ]]; then
        mqtt_auth_enabled=true
        [[ "$IOTEMPOWER_MQTT_USER" && "$IOTEMPOWER_MQTT_PW" ]] \
            || mqtt_fail "MQTT user and password must both be set when MQTT auth is configured. Aborting."
        [[ "$IOTEMPOWER_MQTT_USE_TLS" == 1 ]] || mqtt_fail "MQTT auth requires TLS. Aborting."
        [[ "$IOTEMPOWER_MQTT_USER" != *[[:space:]]* ]] || mqtt_fail "MQTT username may not contain whitespace. Aborting."
        [[ "$IOTEMPOWER_MQTT_USER" != *:* ]] || mqtt_fail "MQTT username may not contain colon. Aborting."
        command -v mosquitto_passwd >/dev/null || mqtt_fail "MQTT auth requires mosquitto_passwd. Aborting."

        mqtt_create_password_file "$APTEMP/password_file" \
            || mqtt_fail "Failed to generate Mosquitto password file. Aborting."
        mqtt_write_acl_file "$APTEMP/acl_file" || mqtt_fail "Failed to generate Mosquitto ACL file. Aborting."
        chmod 600 "$APTEMP/acl_file"
    fi

    # Create mosquitto config - user is needed for root on docker
    MQTT_BROKER_USER="${USER:-$(id -un 2>/dev/null)}"
    MQTT_BROKER_USER_LINE=""
    [[ "$MQTT_BROKER_USER" ]] && MQTT_BROKER_USER_LINE="user $MQTT_BROKER_USER"
    cat << EOF > "$APTEMP/mosquitto.conf"
pid_file $APTEMP/pid
$MQTT_BROKER_USER_LINE
persistence false
persistence_location $APTEMP/mosquitto.db
log_dest stdout
log_type error
log_type warning
EOF

    if [[ "$mqtt_auth_enabled" == true ]]; then
        cat << EOF >> "$APTEMP/mosquitto.conf"
allow_anonymous false
password_file $APTEMP/password_file
acl_file $APTEMP/acl_file
EOF
    else
        cat << EOF >> "$APTEMP/mosquitto.conf"
allow_anonymous true
EOF
    fi

    if [[ "$IOTEMPOWER_MQTT_USE_TLS" == 1 ]]; then
        if [[ "$mqtt_tls_mode" == "psk" ]]; then
            mqtt_write_psk_file "$APTEMP/psk_file" \
                || mqtt_fail "Failed to generate Mosquitto PSK file. Aborting."
            cat << EOF >> "$APTEMP/mosquitto.conf"
# TLS-PSK
listener 8883 $IOTEMPOWER_MQTT_HOST
psk_hint iotempower
psk_file $APTEMP/psk_file
tls_version tlsv1.2
ciphers PSK-AES128-GCM-SHA256
EOF
            if [[ "$IOTEMPOWER_MQTT_HOST2" ]]; then
                cat << EOF >> "$APTEMP/mosquitto.conf"
listener 8883 $IOTEMPOWER_MQTT_HOST2
psk_hint iotempower
psk_file $APTEMP/psk_file
tls_version tlsv1.2
ciphers PSK-AES128-GCM-SHA256
EOF
            fi
        elif [[ ! "$IOTEMPOWER_MQTT_CERT_FOLDER" ]]; then
            echo "MQTT TLS enabled, but no certificate folder set. Aborting." 1>&2
            exit 1
        else
    # IOTEMPOWER_MQTT_CERT_FOLDER's default is set in read_system_config
            cat << EOF >> "$APTEMP/mosquitto.conf"
# TLS
listener 8883 $IOTEMPOWER_MQTT_HOST
cafile $IOTEMPOWER_MQTT_CERT_FOLDER/ca.crt
certfile $IOTEMPOWER_MQTT_CERT_FOLDER/server.crt
keyfile $IOTEMPOWER_MQTT_CERT_FOLDER/server.key
require_certificate false  
EOF
            if [[ "$IOTEMPOWER_MQTT_HOST2" ]]; then
                cat << EOF >> "$APTEMP/mosquitto.conf"
listener 8883 $IOTEMPOWER_MQTT_HOST2
cafile $IOTEMPOWER_MQTT_CERT_FOLDER/ca.crt
certfile $IOTEMPOWER_MQTT_CERT_FOLDER/server.crt
keyfile $IOTEMPOWER_MQTT_CERT_FOLDER/server.key
require_certificate false
EOF
            fi
        fi
    else
        cat << EOF >> "$APTEMP/mosquitto.conf"
listener 1883 127.0.0.1
listener 1883 $IOTEMPOWER_MQTT_HOST
EOF
        if [[ "$IOTEMPOWER_MQTT_HOST2" ]]; then
            cat << EOF >> "$APTEMP/mosquitto.conf"
listener 1883 $IOTEMPOWER_MQTT_HOST2
EOF
        fi
    fi

    # Create bridge if needed
    if [[ "$IOTEMPOWER_MQTT_BRIDGE_HOST" ]]; then
        cat << EOF >> "$APTEMP/mosquitto.conf"
connection bridge-to-$IOTEMPOWER_MQTT_BRIDGE_HOST
bridge_capath $IOTEMPOWER_MQTT_BRIDGE_CERTPATH
bridge_insecure false
address $IOTEMPOWER_MQTT_BRIDGE_HOST:$IOTEMPOWER_MQTT_BRIDGE_PORT
cleansession false
clientid bridge-$HOSTNAME-$IOTEMPOWER_MQTT_BRIDGE_HOST
start_type automatic
username $IOTEMPOWER_MQTT_BRIDGE_USER
password $IOTEMPOWER_MQTT_BRIDGE_PW
notifications false
try_private true
topic # both 2 ${IOTEMPOWER_MQTT_BRIDGE_TOPIC}/ ${IOTEMPOWER_MQTT_BRIDGE_TOPIC}/
EOF
    fi

    echo "Stopping all existing services."
    pkill mosquitto
    sleep 1
    echo "Starting mosquitto."
    mosquitto -v -c "$APTEMP/mosquitto.conf"
done
